<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:home="using:PrismWave.Avalonia.Controls.Home"
             x:Class="PrismWave.Avalonia.Views.Home.HomePage">
  <Grid Margin="24,18,24,18" RowDefinitions="Auto,*">
    <Grid Height="40" Margin="0,0,0,12" ColumnDefinitions="*,Auto">
      <TextBlock
          Text="首页"
          Classes="pageTitle"
          FontSize="30"
          VerticalAlignment="Center" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <fa:ProgressRing
            Width="18"
            Height="18"
            IsActive="{Binding IsRefreshing}"
            VerticalAlignment="Center" />
        <Button
            Width="40"
            Height="40"
            Padding="0"
            Command="{Binding RefreshHomeCommand}">
          <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" Padding="0,0,0,6">
      <StackPanel Spacing="11">
        <home:TrendingBanner
            Title="今日趋势"
            Subtitle="{Binding TopPlaylist.Subtitle}"
            BackdropUrl="{Binding BannerBackdrop}"
            Tracks="{Binding BannerTracks}"
            PlayCommand="{Binding PlayTopPlaylistCommand}"
            OpenRequested="TrendingBanner_OpenRequested" />

        <home:TrendingSongList
            Margin="0,14,0,20"
            ItemsSource="{Binding GlobalTrendingTracks}"
            PlayCommand="{Binding PlayHomeTrackCommand}" />

        <home:EditorialFeature
            Margin="0,14,0,28"
            Section="{Binding EditorialSection}"
            PlayCommand="{Binding PlayHomeTrackCommand}" />

        <home:GenreExplorer
            Margin="0,14,0,32"
            ChannelSections="{Binding ChannelSections}"
            GenreSections="{Binding GenreSections}"
            OpenRequested="GenreExplorer_OpenRequested" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
