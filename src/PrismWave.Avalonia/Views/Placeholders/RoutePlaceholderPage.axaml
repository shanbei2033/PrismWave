<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrismWave.Avalonia.Views.Placeholders.RoutePlaceholderPage">
  <Panel>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
      <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold"
                 Foreground="{StaticResource PrismTextPrimaryBrush}" HorizontalAlignment="Center" />
      <TextBlock Text="页面建设中" FontSize="14"
                 Foreground="{StaticResource PrismTextMutedBrush}" HorizontalAlignment="Center" />
    </StackPanel>
  </Panel>
</UserControl>
