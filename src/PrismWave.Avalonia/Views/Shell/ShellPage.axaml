<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uic="using:FluentAvalonia.UI.Controls"
             xmlns:playback="using:PrismWave.Avalonia.Controls.Playback"
             x:Class="PrismWave.Avalonia.Views.Shell.ShellPage"
             x:Name="ShellRoot">
  <Grid Background="{StaticResource PrismBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <uic:NavigationView
        x:Name="Nav"
        Grid.Row="0"
        Margin="0,42,0,0"
        PaneDisplayMode="Left"
        OpenPaneLength="220"
        CompactPaneLength="48"
        IsPaneOpen="True"
        IsPaneToggleButtonVisible="True"
        IsSettingsVisible="True"
        ItemInvoked="Nav_ItemInvoked">
      <uic:NavigationView.MenuItems>
        <uic:NavigationViewItem Content="{Binding HomeLabel}" Tag="Home" IsVisible="{Binding IsOnlineNavigationVisible}">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xE80F;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
        <uic:NavigationViewItem Content="{Binding SearchLabel}" Tag="Search" IsVisible="{Binding IsOnlineNavigationVisible}">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xE721;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
        <uic:NavigationViewItem Content="{Binding LibraryLabel}" Tag="Library">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8D6;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
        <uic:NavigationViewItem Content="{Binding AlbumsLabel}" Tag="Albums">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xE90B;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
        <uic:NavigationViewItem Content="{Binding ArtistsLabel}" Tag="Artists">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xE77B;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
        <uic:NavigationViewItem Content="{Binding FavoritesLabel}" Tag="Favorites">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xEB51;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
        <uic:NavigationViewItem Content="HITS" Tag="Hits" IsVisible="{Binding IsOnlineNavigationVisible}">
          <uic:NavigationViewItem.IconSource>
            <uic:FontIconSource FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets" FontSize="16" Glyph="&#xE8D8;" />
          </uic:NavigationViewItem.IconSource>
        </uic:NavigationViewItem>
      </uic:NavigationView.MenuItems>

      <Panel>
        <ContentControl x:Name="ContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Panel>
    </uic:NavigationView>

    <!-- 底部播放栏 -->
    <playback:BottomPlayerBar
        x:Name="ShellBottomPlayerBar"
        Grid.Row="1"
        Margin="8,16,8,8"
        DataContext="{Binding Playback}"
        FullPlayCommand="{Binding #ShellRoot.DataContext.OpenFullPlayCommand}"
        QueueCommand="{Binding #ShellRoot.DataContext.ToggleQueuePaneCommand}" />

    <!-- 播放队列覆盖层 -->
    <Grid
        x:Name="QueueOverlay"
        Grid.Row="0"
        Margin="0,42,0,0"
        IsVisible="{Binding IsQueuePaneOpen}"
        IsHitTestVisible="{Binding IsQueuePaneOpen}">
      <Border
          x:Name="QueueBackdrop"
          Background="#52000000"
          PointerPressed="QueueBackdrop_PointerPressed" />
      <playback:QueuePane
          x:Name="PlaybackQueuePane"
          Width="344"
          HorizontalAlignment="Right"
          DataContext="{Binding Playback}" />
    </Grid>

    <!-- 全屏播放覆盖层（FullPlay 沉浸路由） -->
    <Grid
        x:Name="FullPlayOverlay"
        Grid.Row="0"
        Grid.RowSpan="2"
        IsVisible="False"
        IsHitTestVisible="False">
      <ContentControl x:Name="FullPlayHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
  </Grid>
</UserControl>
