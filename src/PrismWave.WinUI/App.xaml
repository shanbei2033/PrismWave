<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PrismWave_WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="Themes/PrismTokens.xaml" />
                <ResourceDictionary Source="Themes/PrismControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:CoverImageSourceConverter x:Key="CoverImageSourceConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
