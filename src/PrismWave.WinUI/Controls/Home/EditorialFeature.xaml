<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Home.EditorialFeature"
    x:Name="EditorialRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="EditorialFeature_SizeChanged">

    <Grid x:Name="LayoutRoot" ColumnSpacing="32" RowSpacing="18">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="MediaColumn.Width" Value="*" />
                        <Setter Target="CopyColumn.Width" Value="0" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="0" />
                        <Setter Target="FeatureMedia.Height" Value="200" />
                        <Setter Target="FeatureCopy.(Grid.Row)" Value="1" />
                        <Setter Target="FeatureCopy.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="MediaColumn.Width" Value="300" />
                        <Setter Target="CopyColumn.Width" Value="*" />
                        <Setter Target="LayoutRoot.ColumnSpacing" Value="32" />
                        <Setter Target="FeatureMedia.Height" Value="220" />
                        <Setter Target="FeatureCopy.(Grid.Row)" Value="0" />
                        <Setter Target="FeatureCopy.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="MediaColumn" Width="300" />
            <ColumnDefinition x:Name="CopyColumn" Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            x:Name="FeatureMedia"
            Grid.Row="0"
            Grid.Column="0"
            Height="220"
            Background="{StaticResource PrismSurfaceStrongBrush}"
            CornerRadius="8"
            AutomationProperties.AutomationId="EditorialArtworkHost">
            <Grid>
                <FontIcon
                    Glyph="&#xE8D6;"
                    FontSize="32"
                    Foreground="{StaticResource PrismTextMutedBrush}" />
                <Image
                    Source="{Binding FeaturedCoverUrl, ElementName=EditorialRoot, Converter={StaticResource CoverImageSourceConverter}}"
                    Stretch="UniformToFill"
                    ImageFailed="EditorialArtwork_ImageFailed"
                    AutomationProperties.AutomationId="EditorialArtwork" />
            </Grid>
        </Border>

        <StackPanel
            x:Name="FeatureCopy"
            Grid.Row="0"
            Grid.Column="1"
            MaxWidth="560"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Spacing="7">
            <TextBlock
                Text="精选"
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrismAccentSoftBrush}"
                AutomationProperties.AutomationId="EditorialEyebrow" />
            <TextBlock
                Text="{Binding FeatureTitle, ElementName=EditorialRoot}"
                FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                FontSize="28"
                FontWeight="Bold"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                AutomationProperties.AutomationId="EditorialTitle" />
            <TextBlock
                Text="{Binding TrackCountLabel, ElementName=EditorialRoot}"
                FontSize="12"
                Foreground="{StaticResource PrismTextMutedBrush}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="EditorialTrackCount" />
            <Rectangle
                Width="44"
                Height="2"
                Margin="0,2,0,1"
                HorizontalAlignment="Left"
                Fill="{StaticResource PrismAccentBrush}" />
            <TextBlock
                Text="{Binding FeaturedTrackTitle, ElementName=EditorialRoot}"
                FontSize="15"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                AutomationProperties.AutomationId="EditorialFeaturedTitle" />
            <TextBlock
                Text="{Binding FeaturedTrackArtist, ElementName=EditorialRoot}"
                FontSize="12"
                Foreground="{StaticResource PrismTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                AutomationProperties.AutomationId="EditorialFeaturedArtist" />
            <Button
                Height="40"
                Margin="0,5,0,0"
                Padding="16,0"
                HorizontalAlignment="Left"
                Command="{Binding PlayCommand, ElementName=EditorialRoot}"
                CommandParameter="{Binding FeaturedTrack, ElementName=EditorialRoot}"
                Background="{StaticResource PrismAccentBrush}"
                BorderThickness="0"
                CornerRadius="8"
                AutomationProperties.AutomationId="EditorialPlayButton">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE768;" FontSize="15" />
                    <TextBlock Text="立即播放" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
