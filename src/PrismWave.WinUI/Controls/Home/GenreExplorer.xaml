<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Home.GenreExplorer"
    x:Name="ExplorerRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DataTemplate x:Key="ExplorerEntryTemplate">
            <Button
                Height="46"
                Padding="12,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="8"
                Tag="{Binding Section}"
                Click="ExplorerEntry_Click"
                AutomationProperties.AutomationId="ExplorerEntryButton"
                AutomationProperties.Name="{Binding Title}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon
                        Width="22"
                        Height="22"
                        Glyph="{Binding IconGlyph}"
                        FontSize="16"
                        Foreground="{StaticResource PrismAccentSoftBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ExplorerEntryIcon" />

                    <TextBlock
                        Grid.Column="1"
                        Text="{Binding Title}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="ExplorerEntryTitle" />

                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <StackPanel Spacing="8">
            <TextBlock
                Text="频道"
                Style="{StaticResource PrismSectionTitleTextStyle}"
                FontSize="18"
                AutomationProperties.AutomationId="ChannelExplorerHeading" />

            <ItemsRepeater
                ItemsSource="{Binding ChannelItems, ElementName=ExplorerRoot}"
                ItemTemplate="{StaticResource ExplorerEntryTemplate}"
                AutomationProperties.AutomationId="ChannelExplorerRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="170"
                        MinItemHeight="46"
                        MinRowSpacing="8"
                        MinColumnSpacing="8"
                        ItemsStretch="Fill"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>

        <StackPanel Spacing="8">
            <TextBlock
                Text="流派探索"
                Style="{StaticResource PrismSectionTitleTextStyle}"
                FontSize="21"
                AutomationProperties.AutomationId="GenreExplorerHeading" />

            <ItemsRepeater
                ItemsSource="{Binding GenreItems, ElementName=ExplorerRoot}"
                ItemTemplate="{StaticResource ExplorerEntryTemplate}"
                AutomationProperties.AutomationId="GenreExplorerRepeater">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        MinItemWidth="170"
                        MinItemHeight="46"
                        MinRowSpacing="8"
                        MinColumnSpacing="8"
                        ItemsStretch="Fill"
                        ItemsJustification="Start" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </StackPanel>
</UserControl>
