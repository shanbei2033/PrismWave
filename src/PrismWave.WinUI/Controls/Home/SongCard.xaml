<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Home.SongCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="170"
    MinHeight="224">
    <Border
        Padding="10,8,10,10"
        Background="{StaticResource PrismGlassSoftBrush}"
        BorderBrush="{StaticResource PrismCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Height="150" Background="{StaticResource PrismSurfaceStrongBrush}" CornerRadius="9">
                <Grid>
                    <FontIcon Glyph="&#xE8D6;" FontSize="24" Foreground="{StaticResource PrismTextMutedBrush}" />
                    <Image
                        Source="{Binding CoverUrl, Converter={StaticResource CoverImageSourceConverter}}"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>
            <TextBlock
                Grid.Row="1"
                Margin="0,10,0,0"
                Text="{Binding Title}"
                FontSize="13"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
            <TextBlock
                Grid.Row="2"
                Margin="0,5,0,0"
                Text="{Binding Artist}"
                Style="{StaticResource PrismCaptionTextStyle}"
                FontSize="12"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Grid>
    </Border>
</UserControl>
