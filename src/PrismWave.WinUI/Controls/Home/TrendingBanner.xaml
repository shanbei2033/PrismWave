<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Home.TrendingBanner"
    x:Name="BannerRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="BannerRoot_SizeChanged">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TrendingOverlayBrush" Color="{StaticResource PrismSurfaceColor}" Opacity="0.72" />
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="CoverCollage.Visibility" Value="Collapsed" />
                        <Setter Target="CoverColumn.Width" Value="0" />
                        <Setter Target="BannerTitle.FontSize" Value="36" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="CoverCollage.Visibility" Value="Visible" />
                        <Setter Target="CoverColumn.Width" Value="320" />
                        <Setter Target="BannerTitle.FontSize" Value="44" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border
            x:Name="HeroSurface"
            MinHeight="220"
            Background="{StaticResource PrismSurfaceStrongBrush}"
            BorderThickness="0"
            CornerRadius="12"
            AutomationProperties.AutomationId="TrendingHero">
            <Grid>
            <Image
                Height="220"
                Source="{Binding BackdropUrl, ElementName=BannerRoot, Converter={StaticResource CoverImageSourceConverter}}"
                Stretch="UniformToFill"
                Opacity="0.55"
                AutomationProperties.AutomationId="HeroBackdrop" />
            <Border Background="{StaticResource PrismGlassBrush}" CornerRadius="12" Opacity="0.5" />

            <Grid Padding="28,20,24,20" ColumnSpacing="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="CoverColumn" Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    x:Name="HeroCopy"
                    MaxWidth="600"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Spacing="7">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock
                            Text="TRENDING"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrismTextSecondaryBrush}" />
                        <TextBlock
                            Text="TOP 100"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrismAccentSoftBrush}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="BannerTitle"
                        Text="{Binding Title, ElementName=BannerRoot}"
                        FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                        FontSize="44"
                        FontWeight="Bold"
                        Foreground="{StaticResource PrismTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <TextBlock
                        MaxWidth="560"
                        Text="汇集今天最受关注的作品，按全球趋势持续更新。"
                        FontSize="15"
                        Foreground="{StaticResource PrismTextSecondaryBrush}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        MaxWidth="560"
                        Text="{Binding Subtitle, ElementName=BannerRoot}"
                        FontSize="12"
                        Foreground="{StaticResource PrismTextMutedBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                        <Button
                            Height="38"
                            Padding="16,0"
                            Command="{Binding PlayCommand, ElementName=BannerRoot}"
                            Background="{StaticResource PrismAccentBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <FontIcon Glyph="&#xE768;" FontSize="15" />
                                <TextBlock Text="播放全部" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button
                            Width="38"
                            Height="38"
                            Padding="0"
                            Click="OpenButton_Click"
                            Foreground="White"
                            >
                            <FontIcon Glyph="&#xE8A7;" FontSize="15" />
                        </Button>
                    </StackPanel>
                </StackPanel>

                <Grid
                    x:Name="CoverCollage"
                    Grid.Column="1"
                    Width="320"
                    Height="184"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    AutomationProperties.AutomationId="HeroCoverCollage">
                    <Border
                        Width="112"
                        Height="112"
                        Margin="4,14,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{StaticResource PrismSurfaceStrongBrush}"
                        CornerRadius="10"
                        Opacity="0.72"
                        Rotation="-5">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{StaticResource PrismTextMutedBrush}" />
                            <Image
                                Source="{Binding CoverOneUrl, ElementName=BannerRoot, Converter={StaticResource CoverImageSourceConverter}}"
                                Stretch="UniformToFill"
                                AutomationProperties.AutomationId="HeroCoverOne" />
                        </Grid>
                    </Border>
                    <Border
                        Width="118"
                        Height="118"
                        Margin="0,2,70,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{StaticResource PrismSurfaceStrongBrush}"
                        CornerRadius="10"
                        Opacity="0.82"
                        Rotation="4">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="28" Foreground="{StaticResource PrismTextMutedBrush}" />
                            <Image
                                Source="{Binding CoverTwoUrl, ElementName=BannerRoot, Converter={StaticResource CoverImageSourceConverter}}"
                                Stretch="UniformToFill"
                                AutomationProperties.AutomationId="HeroCoverTwo" />
                        </Grid>
                    </Border>
                    <Border
                        Width="128"
                        Height="128"
                        Margin="0,0,6,8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PrismSurfaceStrongBrush}"
                        CornerRadius="10"
                        Opacity="0.9"
                        Rotation="5">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="30" Foreground="{StaticResource PrismTextMutedBrush}" />
                            <Image
                                Source="{Binding CoverThreeUrl, ElementName=BannerRoot, Converter={StaticResource CoverImageSourceConverter}}"
                                Stretch="UniformToFill"
                                AutomationProperties.AutomationId="HeroCoverThree" />
                        </Grid>
                    </Border>
                    <Border
                        Width="148"
                        Height="148"
                        Margin="72,0,0,4"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource PrismSurfaceStrongBrush}"
                        CornerRadius="10"
                        Rotation="-2">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="34" Foreground="{StaticResource PrismTextMutedBrush}" />
                            <Image
                                Source="{Binding CoverFourUrl, ElementName=BannerRoot, Converter={StaticResource CoverImageSourceConverter}}"
                                Stretch="UniformToFill"
                                AutomationProperties.AutomationId="HeroCoverFour" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            </Grid>
        </Border>
    </Grid>
</UserControl>
