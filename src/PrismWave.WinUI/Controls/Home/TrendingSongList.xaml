<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Home.TrendingSongList"
    x:Name="TrendingRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="TrendingSongList_SizeChanged">

    <UserControl.Resources>
        <Style x:Key="TrendingRankItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="64" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>

        <DataTemplate x:Key="TrendingRankRowTemplate">
            <Grid MinHeight="64" Padding="8,7,4,7" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="32" />
                </Grid.ColumnDefinitions>

                <Rectangle
                    Grid.ColumnSpan="5"
                    Height="1"
                    Margin="30,0,4,0"
                    VerticalAlignment="Bottom"
                    Fill="{StaticResource PrismCardBorderBrush}"
                    Opacity="0.5" />

                <TextBlock
                    Text="{Binding RankLabel}"
                    FontFamily="Segoe UI Variable Text"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource PrismTextMutedBrush}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />

                <Border
                    Grid.Column="1"
                    Width="48"
                    Height="48"
                    Background="{StaticResource PrismSurfaceStrongBrush}"
                    CornerRadius="6">
                    <Grid>
                        <FontIcon
                            Glyph="&#xE8D6;"
                            FontSize="18"
                            Foreground="{StaticResource PrismTextMutedBrush}" />
                        <Image
                            Source="{Binding CoverUrl, Converter={StaticResource CoverImageSourceConverter}, ConverterParameter=128}"
                            Stretch="UniformToFill"
                            AutomationProperties.AutomationId="GlobalTrendingCover" />
                    </Grid>
                </Border>

                <StackPanel
                    Grid.Column="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    Spacing="3">
                    <TextBlock
                        Text="{Binding Title}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        AutomationProperties.AutomationId="GlobalTrendingTitle" />
                    <TextBlock
                        Text="{Binding Artist}"
                        FontSize="12"
                        Foreground="{StaticResource PrismTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        AutomationProperties.AutomationId="GlobalTrendingArtist" />
                </StackPanel>

                <TextBlock
                    Grid.Column="3"
                    Text="{Binding Duration}"
                    FontSize="11"
                    Foreground="{StaticResource PrismTextMutedBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="GlobalTrendingDuration" />

                <Button
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MoreButton_Click"
                    AutomationProperties.AutomationId="GlobalTrendingMoreButton"
                    AutomationProperties.Name="更多操作">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="播放" Click="PlayMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE768;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="添加到库" Click="AddToLibraryMenuItem_Click" />
                            <MenuFlyoutItem Text="收藏" Click="FavoriteMenuItem_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="LayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.Setters>
                        <Setter Target="RightColumn.Width" Value="0" />
                        <Setter Target="ListGrid.ColumnSpacing" Value="0" />
                        <Setter Target="ListGrid.RowSpacing" Value="2" />
                        <Setter Target="RightList.(Grid.Row)" Value="1" />
                        <Setter Target="RightList.(Grid.Column)" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.Setters>
                        <Setter Target="RightColumn.Width" Value="*" />
                        <Setter Target="ListGrid.ColumnSpacing" Value="24" />
                        <Setter Target="ListGrid.RowSpacing" Value="0" />
                        <Setter Target="RightList.(Grid.Row)" Value="0" />
                        <Setter Target="RightList.(Grid.Column)" Value="1" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="全球热门"
            Margin="0,0,0,8"
            Style="{StaticResource PrismSectionTitleTextStyle}"
            FontSize="21"
            AutomationProperties.AutomationId="GlobalTrendingHeading" />

        <Grid
            x:Name="ListGrid"
            Grid.Row="1"
            ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="RightColumn" Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListView
                x:Name="LeftList"
                Grid.Row="0"
                Grid.Column="0"
                ItemsSource="{Binding LeftTracks, ElementName=TrendingRoot}"
                ItemTemplate="{StaticResource TrendingRankRowTemplate}"
                ItemContainerStyle="{StaticResource TrendingRankItemStyle}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="TrackList_ItemClick"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.AutomationId="GlobalTrendingLeftList" />

            <ListView
                x:Name="RightList"
                Grid.Row="0"
                Grid.Column="1"
                ItemsSource="{Binding RightTracks, ElementName=TrendingRoot}"
                ItemTemplate="{StaticResource TrendingRankRowTemplate}"
                ItemContainerStyle="{StaticResource TrendingRankItemStyle}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="TrackList_ItemClick"
                Background="Transparent"
                BorderThickness="0"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                AutomationProperties.AutomationId="GlobalTrendingRightList" />
        </Grid>
    </Grid>
</UserControl>
