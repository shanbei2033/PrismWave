<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Navigation.Sidebar"
    x:Name="SidebarRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="ExpandedVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="CollapsedVisibilityConverter" Invert="True" />
        <SolidColorBrush x:Key="SidebarSelectedBrush" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#2AFFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#34FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#20FFFFFF" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />

        <Style x:Key="SidebarNavItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Background" Value="{StaticResource PrismControlBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border
                            x:Name="ItemRoot"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource PrismCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PrismCardHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PrismControlBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SidebarSelectedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PrismCardBorderBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOverSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource SidebarSelectedBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PrismCardBorderBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PressedSelected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PrismSelectionBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ItemRoot" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SidebarItemTemplate">
            <Grid Height="34" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Glyph="{Binding Glyph}"
                    FontSize="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Label}"
                    FontSize="15"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    Visibility="{Binding IsExpanded, ElementName=SidebarRoot, Converter={StaticResource ExpandedVisibilityConverter}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border
        Background="{StaticResource PrismGlassBrush}"
        BorderBrush="{StaticResource PrismCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="18">
        <Grid Padding="14,10,14,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Height="42">
                <TextBlock
                    Text="PrismWave"
                    FontFamily="Segoe UI Variable Display, Microsoft YaHei UI"
                    FontSize="25"
                    FontWeight="Bold"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsExpanded, ElementName=SidebarRoot, Converter={StaticResource ExpandedVisibilityConverter}}" />
                <Border
                    Width="36"
                    Height="36"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{StaticResource PrismAccentDeepBrush}"
                    CornerRadius="8"
                    Visibility="{Binding IsExpanded, ElementName=SidebarRoot, Converter={StaticResource CollapsedVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8D6;" FontSize="17" />
                </Border>
            </Grid>

            <Button
                x:Name="CollapseButton"
                Grid.Row="1"
                Width="34"
                Height="34"
                Margin="0,4,0,10"
                Padding="0"
                HorizontalAlignment="Right"
                Background="{StaticResource PrismControlBrush}"
                BorderBrush="{StaticResource PrismCardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Click="CollapseButton_Click"
                ToolTipService.ToolTip="折叠侧栏">
                <FontIcon x:Name="CollapseGlyph" Glyph="&#xE76B;" FontSize="14" />
            </Button>

            <ListView
                x:Name="NavigationList"
                Grid.Row="2"
                Margin="0,0,0,8"
                Padding="0"
                ItemsSource="{x:Bind PrimaryItems}"
                ItemTemplate="{StaticResource SidebarItemTemplate}"
                ItemContainerStyle="{StaticResource SidebarNavItemStyle}"
                IsItemClickEnabled="True"
                ItemClick="NavigationList_ItemClick"
                SelectionMode="Single"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <StackPanel
                Grid.Row="3"
                Margin="2,0,2,8"
                Spacing="2"
                Visibility="{Binding IsExpanded, ElementName=SidebarRoot, Converter={StaticResource ExpandedVisibilityConverter}}">
                <TextBlock Style="{StaticResource PrismCaptionTextStyle}">
                    <Run Text="文件夹: " />
                    <Run Text="{Binding FolderCount, ElementName=SidebarRoot}" />
                </TextBlock>
                <TextBlock Style="{StaticResource PrismCaptionTextStyle}">
                    <Run Text="歌曲: " />
                    <Run Text="{Binding TrackCount, ElementName=SidebarRoot}" />
                </TextBlock>
                <TextBlock Style="{StaticResource PrismCaptionTextStyle}">
                    <Run Text="收藏: " />
                    <Run Text="{Binding FavoriteCount, ElementName=SidebarRoot}" />
                </TextBlock>
            </StackPanel>

            <ListView
                x:Name="FooterList"
                Grid.Row="4"
                Padding="0"
                ItemsSource="{x:Bind FooterItems}"
                ItemTemplate="{StaticResource SidebarItemTemplate}"
                ItemContainerStyle="{StaticResource SidebarNavItemStyle}"
                IsItemClickEnabled="True"
                ItemClick="FooterList_ItemClick"
                SelectionMode="Single"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled" />
        </Grid>
    </Border>
</UserControl>
