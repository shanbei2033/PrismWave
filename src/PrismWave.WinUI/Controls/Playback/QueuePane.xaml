<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PrismWave_WinUI.Controls.Playback.QueuePane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters"
    xmlns:media="using:PrismWave_WinUI.Controls.Media">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="CurrentVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="EmptyQueueVisibilityConverter" Invert="True" />
    </UserControl.Resources>

    <Border
        x:Name="QueueSurface"
        Margin="0,12,12,12"
        Padding="16,14,12,12"
        Background="{StaticResource PrismSurfaceElevatedBrush}"
        BorderBrush="{StaticResource PrismCardBorderBrush}"
        BorderThickness="1"
        CornerRadius="16"
        Translation="0,0,32">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MinHeight="52" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="播放队列" Style="{StaticResource PrismSectionTitleTextStyle}" />
                    <TextBlock Text="{Binding QueueCountLabel}" Style="{StaticResource PrismCaptionTextStyle}" />
                </StackPanel>
                <Button
                    x:Name="QueueCloseButton"
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Close_Click"
                    AutomationProperties.Name="关闭播放队列">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="QueueList"
                    ItemsSource="{Binding QueueItems}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="Queue_ItemClick"
                    CanDragItems="True"
                    CanReorderItems="True"
                    AllowDrop="True"
                    ReorderMode="Enabled"
                    DragItemsStarting="Queue_DragItemsStarting"
                    DragItemsCompleted="Queue_DragItemsCompleted"
                    AutomationProperties.Name="播放队列歌曲">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="MinHeight" Value="64" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64" Tag="{Binding}">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem
                                            Text="从播放队列移除"
                                            Tag="{Binding}"
                                            Click="Remove_Click">
                                            <MenuFlyoutItem.Icon>
                                                <FontIcon Glyph="&#xE74D;" />
                                            </MenuFlyoutItem.Icon>
                                        </MenuFlyoutItem>
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <Border
                                    x:Name="CurrentItemIndicator"
                                    Margin="2"
                                    Background="{StaticResource PrismAccentDeepBrush}"
                                    CornerRadius="8"
                                    Opacity="0.32"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource CurrentVisibilityConverter}}" />
                                <Grid Padding="8,6" ColumnSpacing="9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{Binding PositionLabel}"
                                            HorizontalAlignment="Center"
                                            Foreground="{StaticResource PrismTextSecondaryBrush}"
                                            FontSize="12"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource EmptyQueueVisibilityConverter}}" />
                                        <FontIcon
                                            Glyph="&#xE768;"
                                            FontSize="12"
                                            Foreground="{StaticResource PrismAccentSoftBrush}"
                                            Visibility="{Binding IsCurrent, Converter={StaticResource CurrentVisibilityConverter}}" />
                                    </Grid>

                                    <Border
                                        Grid.Column="1"
                                        Width="48"
                                        Height="48"
                                        Background="{StaticResource PrismSurfaceStrongBrush}"
                                        CornerRadius="7">
                                        <Grid>
                                            <FontIcon
                                                Glyph="&#xE8D6;"
                                                FontSize="16"
                                                Foreground="{StaticResource PrismTextSecondaryBrush}" />
                                            <media:StableCoverImage
                                                Width="48"
                                                Height="48"
                                                SourcePath="{Binding CoverPath}"
                                                Stretch="UniformToFill"
                                                DecodePixelWidth="128" />
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            Text="{Binding Artist}"
                                            MaxLines="1"
                                            TextTrimming="CharacterEllipsis"
                                            Style="{StaticResource PrismCaptionTextStyle}" />
                                    </StackPanel>

                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding HasQueue, Converter={StaticResource EmptyQueueVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8FD;" FontSize="30" Foreground="{StaticResource PrismTextSecondaryBrush}" />
                    <TextBlock Text="播放队列为空" Style="{StaticResource PrismCaptionTextStyle}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" MinHeight="46" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding ModeGlyph}" FontSize="14" Foreground="{StaticResource PrismTextSecondaryBrush}" />
                    <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource PrismCaptionTextStyle}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Width="44"
                    Height="44"
                    Padding="0"
                    Command="{Binding ClearQueueCommand}"
                    AutomationProperties.Name="清空播放队列">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
