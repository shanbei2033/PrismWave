<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PrismWave_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PrismWave"
    mc:Ignorable="d">
    <Grid
        x:Name="WindowRoot"
        Background="{StaticResource PrismBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Frame x:Name="RootFrame" />
        <Grid
            x:Name="TitleBarBackground"
            Height="42"
            VerticalAlignment="Top"
            Background="{StaticResource PrismBackgroundBrush}"
            IsHitTestVisible="False" />
        <Grid
            x:Name="AppTitleBar"
            Height="42"
            Margin="0,0,140,0"
            VerticalAlignment="Top"
            Background="Transparent">
        </Grid>
        <Border
            x:Name="UpdateNotification"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,48,16,0"
            Padding="16,12"
            CornerRadius="8"
            Background="{StaticResource PrismSurfaceElevatedBrush}"
            BorderBrush="{StaticResource PrismCardBorderBrush}"
            BorderThickness="1"
            Visibility="Collapsed"
            Opacity="0">
            <Border.RenderTransform>
                <CompositeTransform TranslateX="320" />
            </Border.RenderTransform>
            <StackPanel Spacing="8" Width="280">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE8A7;" FontSize="18" Foreground="{StaticResource PrismAccentBrush}" />
                        <TextBlock Text="发现新版本" FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                    <Button
                        x:Name="UpdateCloseButton"
                        Click="UpdateCloseButton_Click"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Padding="4"
                        Background="Transparent"
                        BorderThickness="0">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="UpdateVersionText"
                    Style="{StaticResource PrismCaptionTextStyle}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="UpdateDownloadButton"
                    Content="下载更新"
                    Click="UpdateDownloadButton_Click"
                    HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
