<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="PrismWave_WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="PrismWave"
    mc:Ignorable="d">
    <Grid
        x:Name="WindowRoot"
        Background="{StaticResource PrismBackgroundBrush}"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Frame x:Name="RootFrame" />
        <Grid
            x:Name="TitleBarBackground"
            Height="42"
            VerticalAlignment="Top"
            Background="{StaticResource PrismBackgroundBrush}"
            IsHitTestVisible="False" />
        <Grid
            x:Name="AppTitleBar"
            Height="42"
            Margin="0,0,140,0"
            VerticalAlignment="Top"
            Background="Transparent">
            <Image
                Width="24"
                Height="24"
                Margin="12,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="ms-appx:///Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                IsHitTestVisible="False"
                AutomationProperties.Name="PrismWave" />
        </Grid>
    </Grid>
</Window>
