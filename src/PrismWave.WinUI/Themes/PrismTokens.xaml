<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrismBackgroundColor">#FF292A2D</Color>
    <Color x:Key="PrismSurfaceColor">#FF303134</Color>
    <Color x:Key="PrismSurfaceElevatedColor">#FF38393D</Color>
    <Color x:Key="PrismSurfaceStrongColor">#FF45464A</Color>
    <Color x:Key="PrismAccentColor">#FF687BC2</Color>
    <Color x:Key="PrismAccentSoftColor">#FF8D9BD0</Color>
    <Color x:Key="PrismAccentDeepColor">#FF405690</Color>
    <Color x:Key="PrismTextPrimaryColor">#FFF6F6F7</Color>
    <Color x:Key="PrismTextSecondaryColor">#FFB9BEC8</Color>
    <Color x:Key="PrismTextMutedColor">#FF7F8794</Color>
    <Color x:Key="PrismDangerColor">#FFFF6B7A</Color>
    <Color x:Key="PrismWarningColor">#FFFFC86B</Color>

    <SolidColorBrush x:Key="PrismBackgroundBrush" Color="{StaticResource PrismBackgroundColor}" />
    <SolidColorBrush x:Key="PrismSurfaceBrush" Color="{StaticResource PrismSurfaceColor}" />
    <SolidColorBrush x:Key="PrismSurfaceElevatedBrush" Color="{StaticResource PrismSurfaceElevatedColor}" />
    <SolidColorBrush x:Key="PrismSurfaceStrongBrush" Color="{StaticResource PrismSurfaceStrongColor}" />
    <SolidColorBrush x:Key="PrismAccentBrush" Color="{StaticResource PrismAccentColor}" />
    <SolidColorBrush x:Key="PrismAccentSoftBrush" Color="{StaticResource PrismAccentSoftColor}" />
    <SolidColorBrush x:Key="PrismAccentDeepBrush" Color="{StaticResource PrismAccentDeepColor}" />
    <SolidColorBrush x:Key="PrismTextPrimaryBrush" Color="{StaticResource PrismTextPrimaryColor}" />
    <SolidColorBrush x:Key="PrismTextSecondaryBrush" Color="{StaticResource PrismTextSecondaryColor}" />
    <SolidColorBrush x:Key="PrismTextMutedBrush" Color="{StaticResource PrismTextMutedColor}" />
    <SolidColorBrush x:Key="PrismDangerBrush" Color="{StaticResource PrismDangerColor}" />
    <SolidColorBrush x:Key="PrismWarningBrush" Color="{StaticResource PrismWarningColor}" />
    <SolidColorBrush x:Key="PrismCardBorderBrush" Color="#2BFFFFFF" />
    <SolidColorBrush x:Key="PrismCardHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="PrismGlassBrush" Color="#C438393D" />
    <SolidColorBrush x:Key="PrismGlassSoftBrush" Color="#8A414246" />
    <SolidColorBrush x:Key="PrismSelectionBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="PrismControlBrush" Color="#12FFFFFF" />

    <x:Double x:Key="PrismShellSidebarWidth">260</x:Double>
    <x:Double x:Key="PrismShellSidebarCollapsedWidth">76</x:Double>
    <x:Double x:Key="PrismPlayerBarHeight">132</x:Double>
    <x:Double x:Key="PrismQueuePaneWidth">344</x:Double>
    <x:Double x:Key="PrismCardRadius">8</x:Double>
    <x:Double x:Key="PrismPanelRadius">10</x:Double>
    <Thickness x:Key="PrismPagePadding">24,18,24,18</Thickness>
</ResourceDictionary>
