<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PrismWave_WinUI.Views.Dialogs.CoverSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Replace cover"
    CloseButtonText="Close"
    DefaultButton="None">
    <Grid Width="500" MaxHeight="560" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="QueryBox"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="Track, artist or album"
                KeyDown="QueryBox_KeyDown" />
            <Button
                Grid.Column="1"
                Command="{Binding SearchCommand}"
                ToolTipService.ToolTip="Search covers">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE721;" FontSize="15" />
                    <TextBlock Text="Search" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ProgressRing Width="18" Height="18" IsActive="{Binding IsSearching}" />
            <TextBlock
                Grid.Column="1"
                Text="{Binding Status}"
                Style="{StaticResource PrismCaptionTextStyle}"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center" />
        </Grid>

        <GridView
            x:Name="ResultsGrid"
            Grid.Row="2"
            MinHeight="320"
            MaxHeight="430"
            ItemsSource="{Binding Results}"
            IsItemClickEnabled="True"
            SelectionMode="None"
            ItemClick="ResultsGrid_ItemClick">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid
                        Orientation="Horizontal"
                        ItemWidth="158"
                        ItemHeight="218" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="4" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="148" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="142" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Background="{StaticResource PrismSurfaceStrongBrush}"
                            BorderBrush="{StaticResource PrismCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <FontIcon
                                    Glyph="&#xE8D6;"
                                    FontSize="42"
                                    Foreground="{StaticResource PrismTextMutedBrush}" />
                                <Image
                                    Source="{Binding ThumbnailUrl, Converter={StaticResource CoverImageSourceConverter}}"
                                    Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <TextBlock
                            Grid.Row="1"
                            Text="{Binding DisplayTitle}"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrismTextPrimaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <Grid Grid.Row="2" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Artist}"
                                Style="{StaticResource PrismCaptionTextStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding SourceLabel}"
                                Style="{StaticResource PrismCaptionTextStyle}" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</ContentDialog>
