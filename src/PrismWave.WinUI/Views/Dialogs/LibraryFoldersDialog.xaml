<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PrismWave_WinUI.Views.Dialogs.LibraryFoldersDialog"
    x:Name="FolderDialogRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Music folders"
    PrimaryButtonText="Done"
    DefaultButton="Primary">
    <Grid MaxHeight="560" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="{Binding StatusText}"
                Style="{StaticResource PrismCaptionTextStyle}"
                VerticalAlignment="Center" />
            <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{Binding IsScanning}" />
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button Command="{Binding AddFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>
            <Button Command="{Binding RescanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE895;" FontSize="14" />
                    <TextBlock Text="Rescan" />
                </StackPanel>
            </Button>
        </StackPanel>
        <InfoBar
            Grid.Row="2"
            IsOpen="{Binding HasError}"
            Severity="Error"
            Title="Local library"
            Message="{Binding Error}" />
        <Grid Grid.Row="3" Margin="0,2,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Folder" Style="{StaticResource PrismCaptionTextStyle}" />
            <TextBlock Grid.Column="1" Text="Tracks" Style="{StaticResource PrismCaptionTextStyle}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Status" Style="{StaticResource PrismCaptionTextStyle}" />
        </Grid>
        <ListView Grid.Row="4" ItemsSource="{Binding FolderEntries}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding TrackCount}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource PrismCaptionTextStyle}" />
                            <TextBlock Text="{Binding Error}" Style="{StaticResource PrismCaptionTextStyle}" />
                        </StackPanel>
                        <Button
                            Grid.Column="3"
                            Command="{Binding DataContext.RemoveFolderCommand, ElementName=FolderDialogRoot}"
                            CommandParameter="{Binding Path}"
                            ToolTipService.ToolTip="Remove folder">
                            <FontIcon Glyph="&#xE711;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
