<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="PrismWave_WinUI.Views.Dialogs.TrackDetailsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Track details"
    PrimaryButtonText="Open location"
    SecondaryButtonText="Remove..."
    CloseButtonText="Close"
    DefaultButton="Close">
    <Grid MinWidth="560" ColumnSpacing="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="150" Height="150" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}" VerticalAlignment="Top">
            <Image Source="{Binding CoverPath, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
            <TextBlock Text="{Binding Album}" Style="{StaticResource PrismCaptionTextStyle}" />
            <Grid Margin="0,8,0,0" RowSpacing="6" ColumnSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Duration" Style="{StaticResource PrismCaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Duration}" />
                <TextBlock Grid.Row="1" Text="Audio" Style="{StaticResource PrismCaptionTextStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Codec}" />
                <TextBlock Grid.Row="2" Text="Quality" Style="{StaticResource PrismCaptionTextStyle}" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding BitrateLabel}" />
                    <TextBlock Text="{Binding SampleRateLabel}" />
                    <TextBlock Text="{Binding ChannelLabel}" />
                </StackPanel>
                <TextBlock Grid.Row="3" Text="File size" Style="{StaticResource PrismCaptionTextStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FileSizeLabel}" />
            </Grid>
            <TextBlock Margin="0,8,0,0" Text="{Binding Path}" TextWrapping="Wrap" Style="{StaticResource PrismCaptionTextStyle}" />
        </StackPanel>
    </Grid>
</ContentDialog>
