<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Hits.HitsStatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters"
    xmlns:media="using:PrismWave_WinUI.Controls.Media">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="BackKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="HitsIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="23" />
            <Setter Property="Background" Value="#26000000" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PrismBackgroundBrush}">
        <Grid IsHitTestVisible="False" AutomationProperties.AutomationId="HitsBackdrop">
            <media:StableCoverImage
                SourcePath="{Binding CurrentCoverPath}"
                Stretch="UniformToFill"
                Opacity="0.28"
                RenderTransformOrigin="0.5,0.5">
                <media:StableCoverImage.RenderTransform>
                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                </media:StableCoverImage.RenderTransform>
            </media:StableCoverImage>
            <Grid x:Name="HitsBackdropHost" AutomationProperties.AutomationId="HitsBackdropBlur" />
            <Rectangle Fill="#C70A0D13" />
        </Grid>

        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="68" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid
                x:Name="HitsTitleBar"
                Margin="20,0,140,0"
                Background="Transparent"
                BorderBrush="#20FFFFFF"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="BackButton"
                    Style="{StaticResource HitsIconButtonStyle}"
                    Click="BackButton_Click"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Back"
                    AutomationProperties.Name="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="20" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    Text="HITS"
                    FontFamily="Segoe UI Variable Display"
                    FontSize="22"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center" />
                <Grid
                    x:Name="HitsDragRegion"
                    Grid.Column="2"
                    Margin="18,0,0,0"
                    Background="Transparent" />
            </Grid>

            <Grid
                x:Name="ContentLayout"
                Grid.Row="1"
                Padding="40,24,40,44"
                RowSpacing="30"
                ColumnSpacing="72">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup>
                        <VisualState x:Name="CompactState" />
                        <VisualState x:Name="WideState">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="900" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="ContentLayout.Padding" Value="96,40,96,64" />
                                <Setter Target="ContentLayout.ColumnSpacing" Value="96" />
                                <Setter Target="CoverColumn.(Grid.Row)" Value="0" />
                                <Setter Target="CoverColumn.(Grid.Column)" Value="0" />
                                <Setter Target="CoverColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="CoverColumn.MaxWidth" Value="520" />
                                <Setter Target="CoverColumn.MaxHeight" Value="520" />
                                <Setter Target="TrackColumn.(Grid.Row)" Value="0" />
                                <Setter Target="TrackColumn.(Grid.Column)" Value="1" />
                                <Setter Target="TrackColumn.(Grid.ColumnSpan)" Value="1" />
                                <Setter Target="TrackColumn.HorizontalAlignment" Value="Stretch" />
                                <Setter Target="TrackTitle.FontSize" Value="64" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48*" />
                    <ColumnDefinition Width="52*" />
                </Grid.ColumnDefinitions>

                <Viewbox
                    x:Name="CoverColumn"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    MaxWidth="340"
                    MaxHeight="340"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform">
                    <Button
                        x:Name="CoverPlayPauseButton"
                        Width="520"
                        Height="520"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding ToggleLivePlaybackCommand}"
                        AutomationProperties.Name="{Binding CoverAutomationName}"
                        ToolTipService.ToolTip="{Binding CoverAutomationName}"
                        PointerEntered="CoverPlayPauseButton_PointerEntered"
                        PointerExited="CoverPlayPauseButton_PointerExited">
                        <Grid x:Name="CoverVisualHost" Width="520" Height="520">
                            <Border
                                Width="520"
                                Height="520"
                                CornerRadius="26"
                                Background="#331A1D24">
                                <Grid>
                                    <FontIcon Glyph="&#xE8D6;" FontSize="96" Opacity="0.42" />
                                    <media:StableCoverImage
                                        SourcePath="{Binding CurrentCoverPath}"
                                        Stretch="UniformToFill"
                                        AutomationProperties.AutomationId="HitsCover" />
                                </Grid>
                            </Border>
                            <Border
                                x:Name="CoverHoverOverlay"
                                CornerRadius="26"
                                Background="#75000000"
                                Opacity="0">
                                <FontIcon
                                    Glyph="{Binding CoverHintGlyph}"
                                    FontSize="72"
                                    Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>
                </Viewbox>

                <Grid
                    x:Name="TrackColumn"
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    MaxWidth="760"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <StackPanel Spacing="24">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Ellipse
                                Width="8"
                                Height="8"
                                Fill="#FFFF4D4D"
                                VerticalAlignment="Center"
                                Visibility="{Binding ShowLiveDot, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock
                                Text="{Binding BroadcastStateLabel}"
                                FontSize="13"
                                FontWeight="SemiBold"
                                CharacterSpacing="145"
                                Foreground="#FFD9DDE5" />
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{Binding IsConnecting}"
                                Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>

                        <Grid x:Name="TrackInfoSwapHost" MinHeight="176">
                            <StackPanel x:Name="PreviousTrackPanel" Opacity="0" Spacing="8">
                                <TextBlock x:Name="PreviousTrackTitle" FontSize="64" FontWeight="SemiBold" TextWrapping="WrapWholeWords" />
                                <TextBlock x:Name="PreviousTrackArtist" FontSize="24" Foreground="#FFCED2DA" TextWrapping="Wrap" />
                                <TextBlock x:Name="PreviousTrackAlbum" FontSize="16" Foreground="#FF9FA5B0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="CurrentTrackPanel" Spacing="8">
                                <TextBlock
                                    x:Name="TrackTitle"
                                    Text="{Binding DisplayTitle}"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="46"
                                    FontWeight="SemiBold"
                                    TextWrapping="WrapWholeWords"
                                    MaxLines="3" />
                                <TextBlock
                                    Text="{Binding DisplayArtist}"
                                    FontSize="24"
                                    Foreground="#FFCED2DA"
                                    TextWrapping="Wrap"
                                    MaxLines="2" />
                                <TextBlock
                                    Text="{Binding DisplayAlbum}"
                                    FontSize="16"
                                    Foreground="#FF9FA5B0"
                                    TextWrapping="Wrap"
                                    MaxLines="2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
