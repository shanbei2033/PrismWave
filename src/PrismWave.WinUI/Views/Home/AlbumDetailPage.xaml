<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Home.AlbumDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Border Grid.Column="1" Width="96" Height="96" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                <Image Source="{Binding SelectedAlbum.CoverUrl, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedAlbum.Title}" Style="{StaticResource PrismPageTitleTextStyle}" />
                <TextBlock Text="{Binding SelectedAlbum.Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
            </StackPanel>
            <Button Grid.Column="3" Command="{Binding PlaySelectedAlbumCommand}" Background="{StaticResource PrismAccentBrush}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play all" /></StackPanel>
            </Button>
        </Grid>
        <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsAlbumLoading}" />
        <Grid Grid.Row="2">
            <Border Style="{StaticResource PrismPanelBorderStyle}">
                <ListView ItemsSource="{Binding SelectedAlbumTracks}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tracks_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                                    <Image Source="{Binding CoverUrl, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Provider}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
            <InfoBar IsOpen="{Binding HasAlbumError}" Severity="Warning" Title="Album unavailable" Message="{Binding AlbumError}" VerticalAlignment="Top" />
        </Grid>
    </Grid>
</Page>
