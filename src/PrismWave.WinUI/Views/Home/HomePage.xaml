<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Home.HomePage"
    x:Name="HomeRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:homeControls="using:PrismWave_WinUI.Controls.Home">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="PageHeader"
            Grid.Row="0"
            Height="40"
            Margin="0,18,24,12"
            AutomationProperties.AutomationId="HomePageHeader">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Text="首页"
                Style="{StaticResource PrismPageTitleTextStyle}"
                FontSize="30"
                VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing Width="18" Height="18" IsActive="{Binding IsRefreshing}" />
                <Button
                    Width="40"
                    Height="40"
                    Padding="0"
                    AutomationProperties.AutomationId="HomeRefreshButton"
                    Command="{Binding RefreshHomeCommand}"
                    ToolTipService.ToolTip="刷新首页">
                    <FontIcon Glyph="&#xE895;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="0,0,0,6" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="11">
            <homeControls:TrendingBanner
                Title="今日趋势"
                Subtitle="{Binding TopPlaylist.Subtitle}"
                BackdropUrl="{Binding BannerBackdrop}"
                Tracks="{Binding BannerTracks}"
                PlayCommand="{Binding PlayTopPlaylistCommand}"
                OpenRequested="TrendingBanner_OpenRequested" />

            <homeControls:TrendingSongList
                Margin="0,14,20,20"
                ItemsSource="{Binding GlobalTrendingTracks}"
                PlayCommand="{Binding PlayHomeTrackCommand}" />

            <homeControls:EditorialFeature
                Margin="0,14,20,28"
                Section="{Binding EditorialSection}"
                PlayCommand="{Binding PlayHomeTrackCommand}" />

            <homeControls:GenreExplorer
                Margin="0,14,20,32"
                ChannelSections="{Binding ChannelSections}"
                GenreSections="{Binding GenreSections}"
                OpenRequested="GenreExplorer_OpenRequested" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
