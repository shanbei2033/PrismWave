<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Home.TopPlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Back to Home">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding SelectedPlaylist.Title}" Style="{StaticResource PrismPageTitleTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding SelectedPlaylist.Subtitle}" Style="{StaticResource PrismCaptionTextStyle}" />
                    <TextBlock Text="{Binding GeneratedAt}" Style="{StaticResource PrismCaptionTextStyle}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Command="{Binding PlaySelectedPlaylistCommand}" Background="{StaticResource PrismAccentBrush}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play all" /></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PrismPanelBorderStyle}">
            <ListView ItemsSource="{Binding SelectedPlaylist.Tracks}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tracks_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                                <Image Source="{Binding CoverUrl, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Album}" Style="{StaticResource PrismCaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding Provider}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
