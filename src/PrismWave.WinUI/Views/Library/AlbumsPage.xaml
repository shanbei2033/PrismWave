<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Library.AlbumsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Albums" Style="{StaticResource PrismPageTitleTextStyle}" />
            <TextBlock Text="Browse your local collection by album." Style="{StaticResource PrismCaptionTextStyle}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GridView
                ItemsSource="{Binding Albums}"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemClick="Albums_ItemClick">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Border Width="154" Height="205" Margin="0,0,10,10" Style="{StaticResource PrismCardBorderStyle}">
                            <StackPanel Spacing="8">
                                <Border Width="124" Height="124" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                                    <Image Source="{Binding CoverUrl, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <Border Grid.Column="1" Style="{StaticResource PrismPanelBorderStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                            <Image Source="{Binding SelectedAlbum.CoverUrl, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedAlbum.Title}" Style="{StaticResource PrismSectionTitleTextStyle}" />
                            <TextBlock Text="{Binding SelectedAlbum.Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding PlaySelectedCommand}" VerticalAlignment="Center" ToolTipService.ToolTip="Play album">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play all" /></StackPanel>
                        </Button>
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{Binding SelectedTracks}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Tracks_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
