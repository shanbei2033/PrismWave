<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Library.ArtistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Resources>
        <Style x:Key="ArtistTrackItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="58" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click">
                <FontIcon Glyph="&#xE72B;" FontSize="18" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding SelectedArtist.Name}" Style="{StaticResource PrismPageTitleTextStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedArtistMetadata}" Style="{StaticResource PrismCaptionTextStyle}" />
            </StackPanel>
            <Button
                Grid.Column="2"
                Command="{Binding PlaySelectedCommand}"
                Background="{StaticResource PrismAccentBrush}"
                VerticalAlignment="Center"
                >
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="播放全部" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1" Text="歌曲" Style="{StaticResource PrismSectionTitleTextStyle}" Margin="4,8,0,0" />

        <Grid Grid.Row="2" Padding="14,4" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="1.7*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="歌曲" Style="{StaticResource PrismCaptionTextStyle}" />
            <TextBlock Grid.Column="2" Text="专辑" Style="{StaticResource PrismCaptionTextStyle}" />
            <TextBlock Grid.Column="3" Text="时长" Style="{StaticResource PrismCaptionTextStyle}" HorizontalAlignment="Right" />
        </Grid>

        <ListView
            x:Name="ArtistTracksList"
            Grid.Row="3"
            ItemsSource="{Binding SelectedTracks}"
            ItemContainerStyle="{StaticResource ArtistTrackItemStyle}"
            SelectionMode="Single"
            SelectedValuePath="Id"
            SelectedValue="{Binding CurrentTrackId, Mode=OneWay}"
            ContainerContentChanging="ArtistTracksList_ContainerContentChanging">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Tag="{Binding}" Padding="14,7" ColumnSpacing="12" DoubleTapped="TrackRow_DoubleTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="立即播放" Tag="{Binding}" Click="PlayTrack_Click" />
                                <MenuFlyoutItem Text="添加到播放队列" Tag="{Binding}" Click="AddTrackToQueue_Click" />
                                <MenuFlyoutItem Text="下一首播放" Tag="{Binding}" Click="PlayTrackNext_Click" />
                                <MenuFlyoutItem Text="收藏" Tag="{Binding}" Click="FavoriteTrack_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="查看专辑" Tag="{Binding}" Click="ViewTrackAlbum_Click" />
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="1.7*" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="38" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TrackIndex" Style="{StaticResource PrismCaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Album}" Style="{StaticResource PrismCaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Button
                            Grid.Column="4"
                            Width="38"
                            Height="38"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Tag="{Binding}"
                            Click="FavoriteTrack_Click">
                            <FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="15" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
