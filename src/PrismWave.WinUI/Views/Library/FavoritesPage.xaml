<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Library.FavoritesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>
    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Favorites" Style="{StaticResource PrismPageTitleTextStyle}" />
                <TextBlock Text="Your saved tracks, in your preferred order." Style="{StaticResource PrismCaptionTextStyle}" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Command="{Binding PlayAllCommand}" ToolTipService.ToolTip="Play all favorites">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play all" /></StackPanel>
            </Button>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PrismPanelBorderStyle}">
            <Grid>
            <ListView
                ItemsSource="{Binding Tracks}"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Tracks_ItemClick"
                CanDragItems="True"
                CanReorderItems="True"
                AllowDrop="True"
                DragItemsCompleted="Tracks_DragItemsCompleted">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                                <Image Source="{Binding CoverPath, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                            <Button Grid.Column="3" Tag="{Binding}" Click="Favorite_Click" ToolTipService.ToolTip="Remove from favorites">
                                <FontIcon Glyph="{Binding FavoriteGlyph}" FontSize="15" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <FontIcon Glyph="&#xEB51;" FontSize="34" Foreground="{StaticResource PrismTextSecondaryBrush}" />
                <TextBlock Text="No favorites yet" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Use the heart button in your library to save tracks here." Style="{StaticResource PrismCaptionTextStyle}" />
            </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
