<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Library.LocalAlbumDetailPage"
    x:Name="AlbumDetailRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:media="using:PrismWave_WinUI.Controls.Media"
    Background="{StaticResource PrismBackgroundBrush}"
    Loaded="Page_Loaded"
    Unloaded="Page_Unloaded">
    <Page.Resources>
        <Style x:Key="AlbumTrackItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{StaticResource PrismBackgroundBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="58" />
        </Style>
        <Style x:Key="AlbumTrackActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ListView
        x:Name="AlbumTracksList"
        ItemsSource="{Binding SelectedTracks}"
        ItemContainerStyle="{StaticResource AlbumTrackItemStyle}"
        SelectionMode="Single"
        SelectedValuePath="Id"
        SelectedValue="{Binding CurrentTrackId, Mode=OneWay}"
        ContainerContentChanging="AlbumTracksList_ContainerContentChanging">
        <ListView.Header>
            <Grid x:Name="AlbumHero" Height="520" Background="{StaticResource PrismSurfaceBrush}">
                <media:StableCoverImage
                    x:Name="HeroCoverImage"
                    SourcePath="{Binding SelectedAlbum.CoverUrl}"
                    Stretch="UniformToFill"
                    DecodePixelWidth="512"
                    ImageVerticalAlignment="Top" />
                <Grid
                    x:Name="HeroBlurHost"
                    Height="240"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False" />
                <Rectangle
                    x:Name="AlbumTransitionLayer"
                    Canvas.ZIndex="2"
                    Height="180"
                    VerticalAlignment="Bottom"
                    IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush x:Name="AlbumTransitionGradient" StartPoint="0.5,0" EndPoint="0.5,1">
                            <GradientStop x:Name="AlbumGradientStop0" Color="#00292A2D" Offset="0" />
                            <GradientStop x:Name="AlbumGradientStop1" Color="#5C292A2D" Offset="0.34" />
                            <GradientStop x:Name="AlbumGradientStop2" Color="#D4292A2D" Offset="0.72" />
                            <GradientStop x:Name="AlbumGradientStop3" Color="#FF292A2D" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Canvas.ZIndex="1" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#B8000000" Offset="0" />
                            <GradientStop Color="#52000000" Offset="0.46" />
                            <GradientStop Color="#08000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Button
                    Canvas.ZIndex="3"
                    Margin="24,22,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="Back_Click"
                    >
                    <FontIcon Glyph="&#xE72B;" FontSize="18" />
                </Button>

                <Grid Canvas.ZIndex="3" Margin="28,0,28,40" VerticalAlignment="Bottom" ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="7" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock
                            Text="{Binding SelectedAlbum.Title}"
                            FontSize="36"
                            FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"
                            MaxLines="2" />
                        <TextBlock
                            Text="{Binding SelectedAlbum.Artist}"
                            FontSize="17"
                            Foreground="#E8FFFFFF"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Text="{Binding SelectedAlbumMetadata}"
                            Foreground="#B8FFFFFF"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Command="{Binding PlaySelectedCommand}"
                        Background="{StaticResource PrismAccentBrush}"
                        VerticalAlignment="Bottom"
                        >
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon Glyph="&#xE768;" FontSize="15" />
                            <TextBlock Text="播放全部" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </ListView.Header>

        <ListView.ItemContainerTransitions>
            <TransitionCollection>
                <EntranceThemeTransition FromVerticalOffset="10" IsStaggeringEnabled="False" />
            </TransitionCollection>
        </ListView.ItemContainerTransitions>
        <ListView.ItemTemplate>
            <DataTemplate>
                <Grid
                    Tag="{Binding}"
                    Padding="18,7"
                    ColumnSpacing="12"
                    DoubleTapped="TrackRow_DoubleTapped">
                    <Grid.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="立即播放" Tag="{Binding}" Click="PlayTrack_Click" />
                            <MenuFlyoutItem Text="添加到播放队列" Tag="{Binding}" Click="AddTrackToQueue_Click" />
                            <MenuFlyoutItem Text="下一首播放" Tag="{Binding}" Click="PlayTrackNext_Click" />
                            <MenuFlyoutItem Text="收藏" Tag="{Binding}" Click="FavoriteTrack_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="查看艺术家" Tag="{Binding}" Click="ViewTrackArtist_Click" />
                        </MenuFlyout>
                    </Grid.ContextFlyout>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="1.7*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TrackIndex" Style="{StaticResource PrismCaptionTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button
                        Grid.Column="4"
                        Style="{StaticResource AlbumTrackActionButtonStyle}"
                        Tag="{Binding}"
                        Click="FavoriteTrack_Click"
                        AutomationProperties.AutomationId="AlbumTrackFavoriteButton">
                        <FontIcon
                            Glyph="{Binding FavoriteGlyph}"
                            FontSize="18"
                            AutomationProperties.AutomationId="AlbumTrackFavoriteIcon" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ListView.ItemTemplate>
        <ListView.Footer>
            <Grid Height="36" />
        </ListView.Footer>
    </ListView>
</Page>
