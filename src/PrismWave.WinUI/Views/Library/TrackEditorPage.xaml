<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Library.TrackEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource PrismBackgroundBrush}"
    AutomationProperties.AutomationId="TrackEditorPage">
    <Grid Padding="24,18,24,18" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="40"
                Height="40"
                Padding="0"
                Click="Back_Click"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="20"
                AutomationProperties.AutomationId="TrackEditorBackButton">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <TextBlock
                Grid.Column="1"
                Text="编辑元数据"
                Style="{StaticResource PrismSectionTitleTextStyle}"
                VerticalAlignment="Center" />
        </Grid>

        <Border
            x:Name="LockedBanner"
            Grid.Row="1"
            Padding="12,8"
            CornerRadius="6"
            Background="#33F0C67A"
            Visibility="Collapsed"
            AutomationProperties.AutomationId="TrackEditorLockedBanner">
            <TextBlock
                x:Name="LockedBannerText"
                Text="{Binding LockedReason}"
                Foreground="#FFF0C67A"
                FontSize="13"
                TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="32" MinWidth="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10" Width="260">
                    <Border
                        Background="{StaticResource PrismSurfaceBrush}"
                        CornerRadius="10"
                        Height="260">
                        <Image
                            x:Name="CoverPreview"
                            Stretch="Uniform"
                            DoubleTapped="CoverPreview_DoubleTapped"
                            AutomationProperties.AutomationId="TrackEditorCoverPreview" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Content="搜索封面"
                            MinWidth="124"
                            Click="SearchCoverButton_Click"
                            IsEnabled="{Binding CanEditNow}"
                            AutomationProperties.AutomationId="TrackEditorSearchCoverButton" />
                        <Button
                            Content="重置封面"
                            MinWidth="124"
                            Click="ResetCoverButton_Click"
                            IsEnabled="{Binding CanEditNow}"
                            AutomationProperties.AutomationId="TrackEditorResetCoverButton" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Spacing="12"
                    MinWidth="0">
                    <TextBox
                        Header="标题"
                        Text="{Binding Title, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        PlaceholderText="歌曲标题"
                        AutomationProperties.AutomationId="TrackEditorTitleInput" />
                    <TextBox
                        Header="艺术家"
                        Text="{Binding Artist, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        PlaceholderText="多个艺术家用分号分隔"
                        AutomationProperties.AutomationId="TrackEditorArtistInput" />
                    <TextBox
                        Header="专辑"
                        Text="{Binding Album, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        AutomationProperties.AutomationId="TrackEditorAlbumInput" />
                    <TextBox
                        Header="专辑艺术家"
                        Text="{Binding AlbumArtist, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        AutomationProperties.AutomationId="TrackEditorAlbumArtistInput" />
                    <TextBox
                        Header="年份"
                        Text="{Binding Year, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        PlaceholderText="例如 2003"
                        AutomationProperties.AutomationId="TrackEditorYearInput" />
                    <TextBox
                        Header="流派"
                        Text="{Binding Genre, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        PlaceholderText="例如 流行"
                        AutomationProperties.AutomationId="TrackEditorGenreInput" />
                    <TextBox
                        Header="歌词"
                        Text="{Binding Lyrics, Mode=TwoWay}"
                        IsEnabled="{Binding CanEditNow}"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        MinHeight="140"
                        MaxHeight="260"
                        AutomationProperties.AutomationId="TrackEditorLyricsInput" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <ItemsControl ItemsSource="{Binding ReadOnlyInfo}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Text="{Binding}"
                                Style="{StaticResource PrismCaptionTextStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock
                    x:Name="StatusText"
                    Text="{Binding StatusMessage}"
                    Visibility="Collapsed"
                    FontSize="12"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="TrackEditorStatusText" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="保存修改"
                MinWidth="140"
                Style="{StaticResource AccentButtonStyle}"
                Command="{Binding SaveCommand}"
                VerticalAlignment="Center"
                AutomationProperties.AutomationId="TrackEditorSaveButton" />
        </Grid>
    </Grid>
</Page>
