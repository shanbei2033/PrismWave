<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Player.FullPlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters"
    xmlns:lyrics="using:PrismWave_WinUI.Controls.Lyrics"
    xmlns:media="using:PrismWave_WinUI.Controls.Media">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="BackKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="FullPlaySecondaryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="21" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Background="{StaticResource PrismBackgroundBrush}">
        <Grid
            IsHitTestVisible="False"
            AutomationProperties.AutomationId="FullPlayBackdrop">
            <media:StableCoverImage
                SourcePath="{Binding CurrentCoverPath}"
                Stretch="UniformToFill"
                Opacity="0.34"
                RenderTransformOrigin="0.5,0.5"
                AutomationProperties.AutomationId="FullPlayBackdropImage">
                <media:StableCoverImage.RenderTransform>
                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                </media:StableCoverImage.RenderTransform>
            </media:StableCoverImage>
            <Grid
                x:Name="FullPlayBackdropHost"
                AutomationProperties.AutomationId="FullPlayBackdropBlur" />
            <Rectangle Fill="#B80A0D13" />
        </Grid>

        <Grid
            ColumnSpacing="64"
            Padding="56,58,56,34"
            AutomationProperties.AutomationId="FullPlayBody">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42*" />
                <ColumnDefinition Width="58*" />
            </Grid.ColumnDefinitions>

            <Grid
                MaxWidth="520"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                RowSpacing="14"
                AutomationProperties.AutomationId="FullPlayPlayerArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Viewbox
                    MaxWidth="420"
                    MaxHeight="420"
                    Margin="0,0,0,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform">
                    <Border
                        Width="420"
                        Height="420"
                        Background="{StaticResource PrismSurfaceStrongBrush}"
                        CornerRadius="14"
                        DoubleTapped="FullPlayCover_DoubleTapped"
                        ToolTipService.ToolTip="双击更换封面">
                        <Grid Width="420" Height="420">
                            <FontIcon
                                Glyph="&#xE8D6;"
                                FontSize="88"
                                Foreground="{StaticResource PrismTextMutedBrush}" />
                            <media:StableCoverImage
                                SourcePath="{Binding CurrentCoverPath}"
                                Stretch="UniformToFill"
                                AutomationProperties.AutomationId="FullPlayCover" />
                        </Grid>
                    </Border>
                </Viewbox>

                <StackPanel
                    Grid.Row="1"
                    MaxWidth="500"
                    HorizontalAlignment="Stretch"
                    Spacing="3">
                    <TextBlock
                        Text="{Binding CurrentTitle}"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrismTextPrimaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        AutomationProperties.AutomationId="FullPlayTrackTitle" />
                    <TextBlock
                        Text="{Binding CurrentArtist}"
                        FontSize="15"
                        Foreground="{StaticResource PrismTextSecondaryBrush}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        AutomationProperties.AutomationId="FullPlayTrackArtist" />
                </StackPanel>

                <Grid Grid.Row="2" HorizontalAlignment="Center" ColumnSpacing="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Command="{Binding ToggleCurrentFavoriteCommand}"
                        IsEnabled="{Binding CanFavoriteCurrentTrack}"
                        Style="{StaticResource FullPlaySecondaryButtonStyle}"
                        ToolTipService.ToolTip="收藏"
                        AutomationProperties.AutomationId="FullPlayFavoriteButton">
                        <FontIcon Glyph="{Binding CurrentFavoriteGlyph}" FontSize="17" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        Command="{Binding CycleModeCommand}"
                        Style="{StaticResource FullPlaySecondaryButtonStyle}"
                        ToolTipService.ToolTip="{Binding ModeLabel}"
                        AutomationProperties.AutomationId="FullPlayModeButton">
                        <FontIcon Glyph="&#xE8EE;" FontSize="17" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Command="{Binding PreviousCommand}"
                        Style="{StaticResource FullPlaySecondaryButtonStyle}"
                        ToolTipService.ToolTip="上一首"
                        AutomationProperties.AutomationId="FullPlayPreviousButton">
                        <FontIcon Glyph="&#xE892;" FontSize="18" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        Width="56"
                        Height="56"
                        Padding="0"
                        Command="{Binding TogglePlayPauseCommand}"
                        Background="{StaticResource PrismAccentBrush}"
                        BorderThickness="0"
                        CornerRadius="28"
                        ToolTipService.ToolTip="播放或暂停"
                        AutomationProperties.AutomationId="FullPlayPlayPauseButton">
                        <Grid>
                            <FontIcon Glyph="{Binding ToggleGlyph}" FontSize="22" />
                            <ProgressRing
                                Width="22"
                                Height="22"
                                IsActive="{Binding IsLoading}"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button
                        Grid.Column="4"
                        Command="{Binding NextCommand}"
                        Style="{StaticResource FullPlaySecondaryButtonStyle}"
                        ToolTipService.ToolTip="下一首"
                        AutomationProperties.AutomationId="FullPlayNextButton">
                        <FontIcon Glyph="&#xE893;" FontSize="18" />
                    </Button>
                    <Button
                        Grid.Column="5"
                        Style="{StaticResource FullPlaySecondaryButtonStyle}"
                        ToolTipService.ToolTip="播放队列"
                        AutomationProperties.AutomationId="FullPlayQueueButton">
                        <FontIcon Glyph="&#xE8FD;" FontSize="17" />
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedRight">
                                <Grid Width="340" Height="390" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="播放队列" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                    <ListView
                                        Grid.Row="1"
                                        ItemsSource="{Binding Queue}"
                                        IsItemClickEnabled="True"
                                        SelectionMode="None"
                                        ItemClick="QueueList_ItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Padding="4,8" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <StackPanel
                        Grid.Column="6"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE995;" FontSize="15" />
                        <Slider
                            Width="76"
                            Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume, Mode=OneWay}"
                            ValueChanged="FullPlayVolumeSlider_ValueChanged"
                            AutomationProperties.AutomationId="FullPlayVolumeSlider" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="3" MinWidth="0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{Binding PositionLabel}"
                        Style="{StaticResource PrismCaptionTextStyle}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="FullPlayPositionLabel" />
                    <Slider
                        x:Name="FullPlaySeekSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        PointerCaptureLost="FullPlaySeekSlider_PointerCaptureLost"
                        KeyUp="FullPlaySeekSlider_KeyUp"
                        AutomationProperties.AutomationId="FullPlaySeekSlider" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{Binding DurationLabel}"
                        Style="{StaticResource PrismCaptionTextStyle}"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="FullPlayDurationLabel" />
                </Grid>
            </Grid>

            <Grid Grid.Column="1">
                <lyrics:LyricsStageControl
                    x:Name="LyricsStage"
                    LyricInvoked="LyricsStage_LyricInvoked"
                    ManualBrowseChanged="LyricsStage_ManualBrowseChanged"
                    AutomationProperties.AutomationId="LyricsStage" />
                <StackPanel
                    MaxWidth="320"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="14"
                    Visibility="{Binding ShowLyricsEmptyState, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.AutomationId="LyricsEmptyState">
                    <FontIcon
                        Glyph="&#xE8D6;"
                        FontSize="34"
                        Foreground="{StaticResource PrismTextMutedBrush}" />
                    <TextBlock
                        Text="{Binding LyricsEmptyMessage}"
                        Foreground="{StaticResource PrismTextSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                    <Button
                        Content="搜索在线歌词"
                        HorizontalAlignment="Center"
                        IsEnabled="{Binding HasTrack}"
                        Click="SearchLyricsButton_Click" />
                </StackPanel>
                <ProgressRing
                    Width="22"
                    Height="22"
                    Margin="0,18,18,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    IsActive="{Binding IsLyricsLoading}"
                    Visibility="{Binding IsLyricsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <Grid
            Width="44"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="LyricsToolsOverlay">
            <StackPanel VerticalAlignment="Bottom" Spacing="8">
                <StackPanel
                    x:Name="LyricsToolActions"
                    Spacing="8"
                    IsHitTestVisible="False"
                    AutomationProperties.AutomationId="LyricsToolActions">
                    <Button
                        x:Name="LyricsSourceButton"
                        Width="44"
                        Height="44"
                        Padding="0"
                        Opacity="0"
                        Command="{Binding ToggleLyricsSourceCommand}"
                        Background="#52000000"
                        BorderThickness="0"
                        CornerRadius="22"
                        ToolTipService.ToolTip="{Binding LyricsSourceLabel}"
                        AutomationProperties.Name="切换歌词来源"
                        AutomationProperties.AutomationId="LyricsSourceButton">
                        <Button.RenderTransform>
                            <TranslateTransform Y="18" />
                        </Button.RenderTransform>
                        <FontIcon Glyph="&#xE8D4;" FontSize="17" />
                    </Button>
                    <Button
                        x:Name="LyricsSearchButton"
                        Width="44"
                        Height="44"
                        Padding="0"
                        Opacity="0"
                        Click="SearchLyricsButton_Click"
                        Background="#52000000"
                        BorderThickness="0"
                        CornerRadius="22"
                        ToolTipService.ToolTip="搜索在线歌词"
                        AutomationProperties.Name="搜索在线歌词"
                        AutomationProperties.AutomationId="LyricsSearchButton">
                        <Button.RenderTransform>
                            <TranslateTransform Y="18" />
                        </Button.RenderTransform>
                        <FontIcon Glyph="&#xE721;" FontSize="17" />
                    </Button>
                    <Button
                        x:Name="LyricsOffsetButton"
                        Width="44"
                        Height="44"
                        Padding="0"
                        Opacity="0"
                        Background="#52000000"
                        BorderThickness="0"
                        CornerRadius="22"
                        ToolTipService.ToolTip="调整歌词偏移"
                        AutomationProperties.Name="调整歌词偏移"
                        AutomationProperties.AutomationId="LyricsOffsetButton">
                        <Button.RenderTransform>
                            <TranslateTransform Y="18" />
                        </Button.RenderTransform>
                        <FontIcon Glyph="&#xE916;" FontSize="17" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="LyricsOffsetFlyout"
                                Placement="LeftEdgeAlignedBottom"
                                Opened="LyricsOffsetFlyout_Opened">
                                <Grid Width="250" RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Text="歌词偏移"
                                        Style="{StaticResource PrismSectionTitleTextStyle}" />
                                    <TextBox
                                        x:Name="LyricsOffsetInput"
                                        Grid.Row="1"
                                        Header="秒"
                                        PlaceholderText="+0.0"
                                        BeforeTextChanging="LyricsOffsetInput_BeforeTextChanging"
                                        KeyDown="LyricsOffsetInput_KeyDown"
                                        AutomationProperties.AutomationId="LyricsOffsetInput" />
                                    <TextBlock
                                        x:Name="LyricsOffsetValidationText"
                                        Grid.Row="2"
                                        Text="请输入整数或一位小数，例如 +0.5 或 -1.0"
                                        Foreground="#FFFF7676"
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Grid Grid.Row="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Text="正值会让歌词延后显示"
                                            Style="{StaticResource PrismCaptionTextStyle}"
                                            VerticalAlignment="Center" />
                                        <Button
                                            Grid.Column="1"
                                            Content="应用"
                                            Click="ApplyLyricsOffsetButton_Click" />
                                    </Grid>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
                <Button
                    x:Name="LyricsToolsToggleButton"
                    Width="44"
                    Height="44"
                    Padding="0"
                    Click="LyricsToolsToggleButton_Click"
                    Background="#78000000"
                    BorderThickness="0"
                    CornerRadius="22"
                    ToolTipService.ToolTip="歌词工具"
                    AutomationProperties.Name="歌词工具"
                    AutomationProperties.AutomationId="LyricsToolsToggleButton">
                    <FontIcon
                        x:Name="LyricsToolsToggleIcon"
                        Glyph="&#xE713;"
                        FontSize="18" />
                </Button>
            </StackPanel>
        </Grid>

        <Button
            Width="40"
            Height="40"
            Margin="24,50,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Click="BackButton_Click"
            Background="#26000000"
            BorderThickness="0"
            CornerRadius="8"
            ToolTipService.ToolTip="返回"
            AutomationProperties.AutomationId="FullPlayBackButton">
            <FontIcon Glyph="&#xE72B;" FontSize="16" />
        </Button>
    </Grid>
</Page>
