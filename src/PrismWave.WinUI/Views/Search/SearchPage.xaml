<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Search.SearchPage"
    x:Name="SearchRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters"
    xmlns:media="using:PrismWave_WinUI.Controls.Media">
    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
        <Style x:Key="SearchListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="搜索" Style="{StaticResource PrismPageTitleTextStyle}" />

        <Grid Grid.Row="1">
            <AutoSuggestBox
                x:Name="SearchBox"
                QueryIcon="Find"
                PlaceholderText="搜索在线和本地音乐"
                Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                QuerySubmitted="SearchBox_QuerySubmitted" />
            <ProgressRing
                Width="18"
                Height="18"
                Margin="0,0,42,0"
                HorizontalAlignment="Right"
                IsActive="{Binding IsSearching}" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid
                Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="搜索历史" Style="{StaticResource PrismSectionTitleTextStyle}" Margin="2,4,0,10" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{Binding History}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="History_ItemClick"
                    ItemContainerStyle="{StaticResource SearchListItemStyle}"
                    Visibility="{Binding HasHistory, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,10">
                                <Grid.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="删除此记录" Tag="{Binding}" Click="RemoveHistory_Click" />
                                    </MenuFlyout>
                                </Grid.ContextFlyout>
                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding HasHistory, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE721;" FontSize="30" Foreground="{StaticResource PrismTextSecondaryBrush}" />
                    <TextBlock Text="暂无搜索历史" Style="{StaticResource PrismCaptionTextStyle}" />
                </StackPanel>
            </Grid>

            <Grid Visibility="{Binding HasSubmittedSearch, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView
                    x:Name="ResultsList"
                    ItemsSource="{Binding DisplayItems}"
                    SelectionMode="None"
                    ItemContainerStyle="{StaticResource SearchListItemStyle}">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="12" IsStaggeringEnabled="False" />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <TextBlock
                                    Text="{Binding Header}"
                                    Style="{StaticResource PrismSectionTitleTextStyle}"
                                    Margin="2,18,0,8"
                                    Visibility="{Binding IsHeader, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <Grid
                                    Tag="{Binding Result}"
                                    Padding="8,6"
                                    MinHeight="58"
                                    ColumnSpacing="12"
                                    Tapped="ResultRow_Tapped"
                                    DoubleTapped="ResultRow_DoubleTapped"
                                    Visibility="{Binding IsTrack, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="立即播放" Tag="{Binding Result}" Click="PlayResult_Click" />
                                            <MenuFlyoutItem Text="添加到播放队列" Tag="{Binding Result}" Click="AddToQueue_Click" />
                                            <MenuFlyoutItem Text="下一首播放" Tag="{Binding Result}" Click="PlayNext_Click" />
                                            <MenuFlyoutItem Text="收藏" Tag="{Binding Result}" Click="Favorite_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="查看专辑" Tag="{Binding Result}" Click="ViewAlbum_Click" />
                                            <MenuFlyoutItem Text="查看艺术家" Tag="{Binding Result}" Click="ViewArtist_Click" />
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="1.7*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.ColumnSpan="7"
                                        CornerRadius="7"
                                        Background="{StaticResource PrismAccentBrush}"
                                        Opacity="0.14"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Border Width="46" Height="46" CornerRadius="7" Background="{StaticResource PrismSurfaceStrongBrush}">
                                        <media:StableCoverImage SourcePath="{Binding Result.CoverPath}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Result.Title}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Result.Artist}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PrismCaptionTextStyle}"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Result.Album}"
                                        TextTrimming="CharacterEllipsis"
                                        Style="{StaticResource PrismCaptionTextStyle}"
                                        VerticalAlignment="Center" />
                                    <Border
                                        Grid.Column="4"
                                        Padding="8,3"
                                        CornerRadius="10"
                                        Background="{StaticResource PrismSurfaceStrongBrush}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Result.Provider}" FontSize="11" Foreground="{StaticResource PrismTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="5"
                                        Text="{Binding Result.Duration}"
                                        Style="{StaticResource PrismCaptionTextStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                    <Button Grid.Column="6" Tapped="ResultMoreButton_Tapped">
                                        <FontIcon Glyph="&#xE712;" FontSize="14" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="立即播放" Tag="{Binding Result}" Click="PlayResult_Click" />
                                                <MenuFlyoutItem Text="添加到播放队列" Tag="{Binding Result}" Click="AddToQueue_Click" />
                                                <MenuFlyoutItem Text="下一首播放" Tag="{Binding Result}" Click="PlayNext_Click" />
                                                <MenuFlyoutItem Text="收藏" Tag="{Binding Result}" Click="Favorite_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="查看专辑" Tag="{Binding Result}" Click="ViewAlbum_Click" />
                                                <MenuFlyoutItem Text="查看艺术家" Tag="{Binding Result}" Click="ViewArtist_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="10,6,0,10"
                                    Visibility="{Binding IsStatus, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ProgressRing
                                        Width="14"
                                        Height="14"
                                        IsActive="True"
                                        Visibility="{Binding IsLoadingStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon
                                        Glyph="&#xE783;"
                                        FontSize="14"
                                        Foreground="{StaticResource SystemFillColorCriticalBrush}"
                                        Visibility="{Binding IsErrorStatus, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource PrismCaptionTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding ShowNoResults, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE721;" FontSize="30" Foreground="{StaticResource PrismTextSecondaryBrush}" />
                    <TextBlock Text="未找到相关歌曲、专辑或艺术家" Style="{StaticResource PrismCaptionTextStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
