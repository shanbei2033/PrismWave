<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Search" Style="{StaticResource PrismPageTitleTextStyle}" />
            <TextBlock Text="Unified local and online search with persisted history." Style="{StaticResource PrismCaptionTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search tracks, artists, albums" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Command="{Binding RunSearchCommand}" Content="Search" />
            <Button Grid.Column="2" Command="{Binding ClearCommand}" Content="Clear" />
        </Grid>
        <ProgressBar Grid.Row="1" IsIndeterminate="{Binding IsSearching}" VerticalAlignment="Bottom" Margin="0,48,0,0" />

        <Grid Grid.Row="2" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource PrismPanelBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Search History" Style="{StaticResource PrismSectionTitleTextStyle}" />
                    <ListView ItemsSource="{Binding History}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="History_ItemClick" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PrismPanelBorderStyle}">
                <ListView ItemsSource="{Binding Results}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Results_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="64" />
                                </Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="8" Background="{StaticResource PrismSurfaceStrongBrush}">
                                    <Image Source="{Binding CoverPath, Converter={StaticResource CoverImageSourceConverter}}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Artist}" Style="{StaticResource PrismCaptionTextStyle}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Provider}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Duration}" Style="{StaticResource PrismCaptionTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Page>
