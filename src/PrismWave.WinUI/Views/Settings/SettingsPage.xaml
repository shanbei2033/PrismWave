<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="{StaticResource PrismPagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Settings" Style="{StaticResource PrismPageTitleTextStyle}" />
        <Pivot Grid.Row="1">
                <PivotItem Header="Basic">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,16,12,16">
                        <Border Style="{StaticResource PrismPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Music folders" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                <ListView ItemsSource="{Binding Folders}" MaxHeight="180" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PrismPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Language and theme" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                <ComboBox Header="Language" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding Language, Mode=TwoWay}" Width="240" />
                                <TextBlock Text="{Binding ThemeName}" Style="{StaticResource PrismCaptionTextStyle}" />
                                <ToggleSwitch Header="Low effects" IsOn="{Binding LowEffects, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PrismPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Flutter preference migration" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                <TextBlock Text="{Binding MigrationStatus}" Style="{StaticResource PrismCaptionTextStyle}" />
                                <TextBlock Text="{Binding MigrationSource}" Style="{StaticResource PrismCaptionTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Online">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,16,12,16">
                        <StackPanel x:Name="StreamingAccountsHeader" Spacing="3">
                            <TextBlock Text="Streaming accounts" Style="{StaticResource PrismSectionTitleTextStyle}" />
                            <TextBlock Text="Scan with NetEase Cloud Music or QQ Music to use the playback rights available to your account." Style="{StaticResource PrismCaptionTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:Name="NeteaseAccountCard" Style="{StaticResource PrismPanelBorderStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrismSurfaceStrongBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="{StaticResource PrismTextMutedBrush}" />
                                        <Image Source="{Binding OnlineAccounts.Netease.AvatarUrl}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="NetEase Cloud Music" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                    <TextBlock Text="{Binding OnlineAccounts.Netease.DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OnlineAccounts.Netease.StatusText}" Style="{StaticResource PrismCaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Tag="netease" Content="Scan login" Click="ScanLogin_Click" />
                                    <Button Tag="netease" Content="Sign out" Click="SignOut_Click" IsEnabled="{Binding OnlineAccounts.Netease.CanSignOut}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="QqAccountCard" Style="{StaticResource PrismPanelBorderStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource PrismSurfaceStrongBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="{StaticResource PrismTextMutedBrush}" />
                                        <Image Source="{Binding OnlineAccounts.Qq.AvatarUrl}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="QQ Music" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                    <TextBlock Text="{Binding OnlineAccounts.Qq.DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OnlineAccounts.Qq.StatusText}" Style="{StaticResource PrismCaptionTextStyle}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Tag="qq" Content="Scan login" Click="ScanLogin_Click" />
                                    <Button Tag="qq" Content="Sign out" Click="SignOut_Click" IsEnabled="{Binding OnlineAccounts.Qq.CanSignOut}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource PrismPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="BETA / Online mode" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                <ToggleSwitch x:Name="ExperimentalFeaturesToggle" Header="Experimental features" IsOn="{Binding ExperimentalFeaturesEnabled, Mode=OneWay}" Toggled="ExperimentalFeatures_Toggled" />
                                <ToggleSwitch Header="Online mode" IsOn="{Binding OnlineModeEnabled, Mode=TwoWay}" IsEnabled="{Binding ExperimentalFeaturesEnabled}" />
                                <ComboBox
                                    Header="Preferred streaming quality"
                                    ItemsSource="{Binding OnlineQualityOptions}"
                                    SelectedItem="{Binding OnlineQualityPreference, Mode=TwoWay}"
                                    IsEnabled="{Binding OnlineAccounts.IsLoginEnabled}"
                                    Width="260"
                                    HorizontalAlignment="Left" />
                                <InfoBar IsOpen="True" Severity="Informational" Title="Third-party providers" Message="Online sources are experimental and can become unavailable when provider policies or endpoints change." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Playback">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Padding="0,16,12,16">
                        <Border Style="{StaticResource PrismPanelBorderStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Audio output" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                <ComboBox Header="Output mode" ItemsSource="{Binding AudioOutputModeOptions}" SelectedItem="{Binding AudioOutputMode, Mode=TwoWay}" Width="280" />
                                <TextBox Header="Output device id" Text="{Binding AudioOutputDevice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        Header="Windows DSD / ASIO device"
                                        ItemsSource="{Binding WindowsDsdDevices}"
                                        DisplayMemberPath="DisplayName"
                                        SelectedValuePath="Id"
                                        SelectedValue="{Binding WindowsDsdDevice, Mode=TwoWay}"
                                        IsEnabled="{Binding ExperimentalFeaturesEnabled}"
                                        HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Command="{Binding RefreshWindowsDsdDevicesCommand}" VerticalAlignment="Bottom" ToolTipService.ToolTip="Refresh ASIO devices">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding WindowsDsdStatus}" Style="{StaticResource PrismCaptionTextStyle}" />
                                <TextBlock Text="{Binding WindowsDsdOutputStatus}" Style="{StaticResource PrismCaptionTextStyle}" />
                                <TextBlock Text="{Binding WindowsDsdActiveDevice}" Style="{StaticResource PrismCaptionTextStyle}" />
                                <TextBlock Text="{Binding WindowsDsdFallbackReason}" TextWrapping="Wrap" Foreground="#FFFFB4B4" FontSize="12" />
                                <ToggleSwitch Header="Fade in / out" IsOn="{Binding FadeEnabled, Mode=TwoWay}" />
                                <Slider Header="Fade duration" Minimum="0" Maximum="2000" StepFrequency="10" Value="{Binding FadeDurationMs, Mode=TwoWay}" />
                                <TextBlock Text="{Binding FadeDuration}" Style="{StaticResource PrismCaptionTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem Header="Developer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="0,16,12,16" Spacing="14">
                        <Border Style="{StaticResource PrismPanelBorderStyle}">
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="300" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Developer logs" Style="{StaticResource PrismSectionTitleTextStyle}" />
                                        <TextBlock Text="{Binding DeveloperLogCount}" Style="{StaticResource PrismCaptionTextStyle}" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                        <Button Command="{Binding OpenDeveloperLogCommand}" ToolTipService.ToolTip="Open log file">
                                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon Glyph="&#xE8A7;" FontSize="14" /><TextBlock Text="Open" /></StackPanel>
                                        </Button>
                                        <Button Command="{Binding ClearDeveloperLogsCommand}" ToolTipService.ToolTip="Clear logs">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding DeveloperLogPath}" TextWrapping="Wrap" Style="{StaticResource PrismCaptionTextStyle}" />
                                <TextBox
                                    Grid.Row="2"
                                    Text="{Binding DeveloperLogText, Mode=OneWay}"
                                    IsReadOnly="True"
                                    AcceptsReturn="True"
                                    TextWrapping="NoWrap"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="11"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </PivotItem>
        </Pivot>
    </Grid>
</Page>
