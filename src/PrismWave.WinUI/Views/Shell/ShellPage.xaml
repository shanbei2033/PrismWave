<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PrismWave_WinUI.Views.Shell.ShellPage"
    x:Name="ShellRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:PrismWave_WinUI.Converters"
    xmlns:playback="using:PrismWave_WinUI.Controls.Playback">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="QueueEscapeKeyboardAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid Background="{StaticResource PrismBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <NavigationView
            x:Name="AppNavigationView"
            Grid.Row="0"
            Margin="0,42,0,0"
            PaneDisplayMode="Left"
            PaneTitle="PrismWave"
            IsPaneOpen="True"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            IsBackButtonVisible="Collapsed"
            OpenPaneLength="220"
            CompactPaneLength="48"
            SelectionChanged="AppNavigationView_SelectionChanged"
            ItemInvoked="AppNavigationView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="Home" IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="搜索" Tag="Search">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="库" Tag="Library">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="专辑" Tag="Albums">
                    <NavigationViewItem.Icon>
                        <ImageIcon
                            Width="20"
                            Height="20"
                            AutomationProperties.AutomationId="AlbumsIcon">
                            <ImageIcon.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/Icons/album.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="艺术家" Tag="Artists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="我最爱的" Tag="Favorites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB51;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="HITS" Tag="Hits">
                    <NavigationViewItem.Icon>
                        <ImageIcon
                            Width="20"
                            Height="20"
                            AutomationProperties.AutomationId="HitsRadioIcon">
                            <ImageIcon.Source>
                                <SvgImageSource UriSource="ms-appx:///Assets/Icons/radio.svg" />
                            </ImageIcon.Source>
                        </ImageIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Margin="24,0,30,0">
                <Grid
                    x:Name="PageTransitionHost"
                    SizeChanged="PageTransitionHost_SizeChanged">
                    <Grid.Clip>
                        <RectangleGeometry x:Name="PageTransitionClip" />
                    </Grid.Clip>
                    <Frame
                        x:Name="PrimaryContentFrame"
                        Background="{StaticResource PrismBackgroundBrush}" />
                    <Frame
                        x:Name="SecondaryContentFrame"
                        Background="{StaticResource PrismBackgroundBrush}"
                        Visibility="Collapsed"
                        IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </NavigationView>

        <Button
            x:Name="TransitionFocusTarget"
            Grid.Row="0"
            Width="1"
            Height="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsHitTestVisible="False"
            IsTabStop="False"
            KeyDown="TransitionFocusTarget_KeyDown"
            Opacity="0" />

        <playback:BottomPlayerBar
            x:Name="ShellBottomPlayerBar"
            Grid.Row="1"
            Margin="8,16,8,8"
            DataContext="{Binding Playback}"
            FullPlayCommand="{Binding DataContext.OpenFullPlayCommand, ElementName=ShellRoot}"
            QueueCommand="{Binding DataContext.ToggleQueuePaneCommand, ElementName=ShellRoot}" />

        <Grid
            x:Name="QueueOverlay"
            Grid.Row="0"
            Margin="0,42,0,0"
            Visibility="Collapsed"
            IsHitTestVisible="False"
            SizeChanged="QueueOverlay_SizeChanged"
            AutomationProperties.AutomationId="QueueOverlay">
            <Border
                x:Name="QueueBackdrop"
                Background="#16000000"
                Opacity="0"
                PointerPressed="QueueBackdrop_PointerPressed" />
            <playback:QueuePane
                x:Name="PlaybackQueuePane"
                Width="344"
                HorizontalAlignment="Right"
                DataContext="{Binding Playback}" />
        </Grid>

        <Grid
            x:Name="FullPlayOverlay"
            Grid.RowSpan="2"
            Margin="0"
            Background="Transparent"
            Visibility="Collapsed"
            Opacity="0"
            IsHitTestVisible="False"
            AutomationProperties.AutomationId="FullPlayOverlay">
            <Frame
                x:Name="FullPlayFrame"
                Background="Transparent"
                IsTabStop="False" />
        </Grid>
    </Grid>
</Page>
